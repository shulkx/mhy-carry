{
  "productName": "MhyCarry",
  "version": "0.2.0",
  "identifier": "io.github.shulkx.mhycarry",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MhyCarry",
        "width": 440,
        "height": 640,
        "minWidth": 400,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Marcus Shu",
    "copyright": "Copyright (c) 2026 Marcus Shu",
    "license": "MIT",
    "homepage": "https://github.com/shulkx/mhy-carry",
    "shortDescription": "识别屏幕上的米哈游游戏登录二维码，用绑定的账号确认登录",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
